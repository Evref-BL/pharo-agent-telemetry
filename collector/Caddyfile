# Only /v1/traces is served, bodies are capped and must arrive in time, and
# nothing about the client (address, forwarded headers) reaches the
# collector. Caddy writes no access log unless asked to, and the loggers that
# would write a request's address (a failed request, a failed upstream, a
# failed TLS handshake) write nothing: what Caddy still logs is its own start
# and its certificates.
{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
		}
	}
	log default {
		exclude http.log.error http.handlers.reverse_proxy http.stdlib
	}
}

{$SITE_ADDRESS} {
	@traces {
		method POST
		path /v1/traces
	}
	handle @traces {
		request_body {
			max_size 4MB
		}
		reverse_proxy otelcol:4318 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-Ip
			header_up -User-Agent
		}
	}
	handle {
		respond 404
	}
}
