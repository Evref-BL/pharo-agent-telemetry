# The public name the collector is reached at; Caddy gets its certificate.
# Locally, http://:80 serves plain HTTP.
SITE_ADDRESS=telemetry.example.org
# The shared token participants send as `Authorization: Bearer <token>`. It is
# public: it keeps scanners out, not people.
COLLECTOR_TOKEN=change-me
# The owner of ./archive, which the collector writes and the import job reads.
ARCHIVE_UID=10001
ARCHIVE_GID=10001
# Where the archive is written on the host.
ARCHIVE_DIR=./archive
# Ports, optionally with an address: 127.0.0.1:4318 for a local stack.
HTTP_PORT=80
HTTPS_PORT=443
# The share of traces kept, from 0 to 100. Lower it only if the volume grows
# beyond what the import and Elasticsearch take.
SAMPLING_PERCENTAGE=100
# The most rotated 10 MB files the archive keeps. Leave it unset: start.sh
# sets it to half the free space of the archive's disk.
# ARCHIVE_MAX_FILES=
